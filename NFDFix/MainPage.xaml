<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NFDFix.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NFDFix"
    xmlns:models="using:NFDFix.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="ToolbarIconSize">14</x:Double>

        <x:Double x:Key="NameColumnMinWidth">120</x:Double>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OptionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="OptionDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OptionDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <SolidColorBrush x:Key="FolderIconBrush" Color="#C98A00" />

        <Style x:Key="LanguageFlyoutPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="232" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!--  A menu item with a check mark, like RadioMenuFlyoutItem, laid out to match the language menu design.  -->
        <Style x:Key="LanguageMenuItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="RootGrid"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="CheckGlyph"
                                Glyph="&#xE73E;"
                                FontSize="12"
                                Opacity="0"
                                Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CheckGlyph.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="12,4,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Padding="8,0,10,0" Height="24" x:Uid="AddFilesButton" Command="{x:Bind ViewModel.AddFilesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource ToolbarIconSize}" />
                        <TextBlock x:Uid="AddFilesText" />
                    </StackPanel>
                </Button>
                <Button Padding="8,0,10,0" Height="24" x:Uid="AddFoldersButton" Command="{x:Bind ViewModel.AddFoldersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource ToolbarIconSize}" />
                        <TextBlock x:Uid="AddFoldersText" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Margin="4,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="8,0" Height="24"
                    Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                    CommandParameter="{x:Bind ItemsList.SelectedItems}"
                    x:Uid="RemoveButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource ToolbarIconSize}" />
                        <TextBlock x:Uid="RemoveText" />
                    </StackPanel>
                </Button>
                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="8,0" Height="24"
                    x:Uid="ClearAllButton" Command="{x:Bind ViewModel.ClearAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontSize="{StaticResource ToolbarIconSize}" />
                        <TextBlock x:Uid="ClearAllText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="8,0" Height="24"
                    Command="{x:Bind ViewModel.RescanCommand}"
                    x:Uid="RescanButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource ToolbarIconSize}" />
                        <TextBlock x:Uid="RescanText" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="LanguageButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="8,0" Height="24">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="{StaticResource ToolbarIconSize}" />
                        <TextBlock x:Name="CurrentLanguageText" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout
                            x:Name="LanguageFlyout"
                            Placement="BottomEdgeAlignedRight"
                            FlyoutPresenterStyle="{StaticResource LanguageFlyoutPresenterStyle}"
                            Opening="OnLanguageFlyoutOpening">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="LanguageHeaderText"
                                    Margin="12,6,12,4"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="LanguageItemsPanel" />
                                <Rectangle Margin="0,4" Style="{StaticResource OptionDividerStyle}" />
                                <StackPanel Margin="12,4,12,6" Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE946;" FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Uid="LanguageRestartNoteText"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Width="24" Height="24" Padding="0"
                    Click="OnAboutClick"
                    x:Uid="AboutButton">
                    <FontIcon Glyph="&#xE946;" FontSize="{StaticResource ToolbarIconSize}" />
                </Button>
            </StackPanel>
        </Grid>

        <Expander
            Grid.Row="1"
            MinHeight="40"
            Padding="42,4,12,4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="True">
            <Expander.Resources>
                <Thickness x:Key="ExpanderHeaderPadding">14,0,0,0</Thickness>
            </Expander.Resources>
            <Expander.Header>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock x:Uid="OptionsHeaderText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.OptionsSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="NoWrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Expander.Header>

            <StackPanel>
                <Grid MinHeight="44" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="RecursiveTitle" Style="{StaticResource OptionTitleStyle}" />
                        <TextBlock x:Uid="RecursiveDescription" Style="{StaticResource OptionDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind local:UiHelpers.OnOff(ViewModel.Recursive), Mode=OneWay}" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Uid="RecursiveToggle"
                            IsEnabled="{x:Bind ViewModel.CanEditOptions, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.Recursive, Mode=TwoWay}"
                            OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0" />
                    </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource OptionDividerStyle}" />

                <Grid MinHeight="44" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="TargetTitle" Style="{StaticResource OptionTitleStyle}" />
                        <TextBlock x:Uid="TargetDescription" Style="{StaticResource OptionDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox
                        IsEnabled="{x:Bind ViewModel.CanEditOptions, Mode=OneWay}"
                        Grid.Column="1" Width="160" VerticalAlignment="Center"
                        SelectedIndex="{x:Bind ViewModel.TargetIndex, Mode=TwoWay}"
                        x:Uid="TargetCombo">
                        <ComboBoxItem x:Uid="TargetFilesAndFolders" />
                        <ComboBoxItem x:Uid="TargetFilesOnly" />
                        <ComboBoxItem x:Uid="TargetFoldersOnly" />
                    </ComboBox>
                </Grid>
                <Rectangle Style="{StaticResource OptionDividerStyle}" />

                <Grid MinHeight="44" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="HiddenTitle" Style="{StaticResource OptionTitleStyle}" />
                        <TextBlock x:Uid="HiddenDescription" Style="{StaticResource OptionDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind local:UiHelpers.OnOff(ViewModel.IncludeHidden), Mode=OneWay}" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Uid="HiddenToggle"
                            IsEnabled="{x:Bind ViewModel.CanEditOptions, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.IncludeHidden, Mode=TwoWay}"
                            OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0" />
                    </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource OptionDividerStyle}" />

                <Grid MinHeight="44" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="ConflictTitle" Style="{StaticResource OptionTitleStyle}" />
                        <TextBlock x:Uid="ConflictDescription" Style="{StaticResource OptionDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox
                        IsEnabled="{x:Bind ViewModel.CanEditOptions, Mode=OneWay}"
                        Grid.Column="1" Width="160" VerticalAlignment="Center"
                        SelectedIndex="{x:Bind ViewModel.ConflictIndex, Mode=TwoWay}"
                        x:Uid="ConflictCombo">
                        <ComboBoxItem x:Uid="ConflictSkip" />
                        <ComboBoxItem x:Uid="ConflictAppendNumber" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Expander>

        <Border
            x:Name="DropTarget"
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            AllowDrop="True"
            DragOver="OnDragOver"
            DragLeave="OnDragLeave"
            Drop="OnDrop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Keep columns in sync with the item template. -->
                <Grid
                    Height="30"
                    Padding="16,0,16,0"
                    ColumnSpacing="8"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
                    CornerRadius="4,4,0,0"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="3*" MinWidth="{StaticResource NameColumnMinWidth}" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="{StaticResource NameColumnMinWidth}" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0" Padding="0"
                        VerticalAlignment="Center"
                        IsChecked="{x:Bind ViewModel.AllChecked, Mode=TwoWay}"
                        x:Uid="SelectAllCheckBox" />
                    <TextBlock x:Uid="ColumnOriginal" Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock x:Uid="ColumnConverted" Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock x:Uid="ColumnLocation" Grid.Column="5" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock x:Uid="ColumnStatus" Grid.Column="6" Style="{StaticResource ColumnHeaderTextStyle}" />
                </Grid>
                <Rectangle
                    Grid.Row="1"
                    Style="{StaticResource OptionDividerStyle}"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}" />

                <ListView
                    x:Name="ItemsList"
                    Grid.Row="2"
                    Padding="0,4"
                    SelectionMode="Extended"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    SelectionChanged="OnSelectionChanged"
                    KeyDown="OnListKeyDown"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="16,0,16,0" />
                            <Setter Property="MinHeight" Value="32" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RenameItem">
                            <Grid Height="32" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="3*" MinWidth="{StaticResource NameColumnMinWidth}" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" MinWidth="{StaticResource NameColumnMinWidth}" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    MinWidth="0" Padding="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    IsEnabled="{x:Bind IsPending, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind OriginalName}" />

                                <FontIcon
                                    Grid.Column="1"
                                    Glyph="{x:Bind TypeGlyph}"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind local:UiHelpers.VisibleIfFalse(IsFolder)}" />
                                <FontIcon
                                    Grid.Column="1"
                                    Glyph="{x:Bind TypeGlyph}"
                                    FontSize="16"
                                    Foreground="{StaticResource FolderIconBrush}"
                                    Visibility="{x:Bind IsFolder}" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind OriginalName}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind FullPath}" />

                                <FontIcon
                                    Grid.Column="3"
                                    Glyph="&#xE72A;"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind ConvertedName, Mode=OneWay}"
                                    Opacity="{x:Bind ConvertedOpacity, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{x:Bind Directory}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="NoWrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Directory}" />

                                <Grid Grid.Column="6" VerticalAlignment="Center">
                                    <Border
                                        Style="{StaticResource BadgeStyle}"
                                        Background="{ThemeResource PendingBadgeBackgroundBrush}"
                                        Visibility="{x:Bind IsPending, Mode=OneWay}">
                                        <TextBlock x:Uid="BadgePending" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border
                                        Style="{StaticResource BadgeStyle}"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Visibility="{x:Bind IsConflict, Mode=OneWay}"
                                        x:Uid="BadgeConflictBorder">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock x:Uid="BadgeConflict" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Style="{StaticResource BadgeStyle}"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{x:Bind IsDone, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock x:Uid="BadgeDone" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Style="{StaticResource BadgeStyle}"
                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                        Visibility="{x:Bind IsFailed, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock x:Uid="BadgeFailed" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    Grid.RowSpan="3"
                    Margin="12"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <Rectangle
                        x:Name="DropZoneFill"
                        RadiusX="6" RadiusY="6"
                        Fill="{ThemeResource DropZoneBackgroundBrush}"
                        Stroke="{ThemeResource DropZoneStrokeBrush}"
                        StrokeThickness="1.5"
                        StrokeDashArray="4,2.67" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Padding="16">
                        <Border
                            Width="64" Height="64"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            CornerRadius="32"
                            Background="{ThemeResource PendingBadgeBackgroundBrush}">
                            <FontIcon Glyph="&#xE898;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                            FontSize="16" FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Padding="8,0,10,0" Height="24" x:Uid="PickFilesButton" Command="{x:Bind ViewModel.AddFilesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource ToolbarIconSize}" />
                                    <TextBlock x:Uid="PickFilesText" />
                                </StackPanel>
                            </Button>
                            <Button Padding="8,0,10,0" Height="24" x:Uid="PickFoldersButton" Command="{x:Bind ViewModel.AddFoldersCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource ToolbarIconSize}" />
                                    <TextBlock x:Uid="PickFoldersText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" MinHeight="32" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <FontIcon
                    Glyph="&#xE946;" FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind local:UiHelpers.VisibleIfFalse(ViewModel.IsBusy), Mode=OneWay}" />
                <ProgressRing
                    Width="14" Height="14" MinWidth="0" MinHeight="0"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="NoWrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="2"
                Style="{StaticResource AccentButtonStyle}"
                Height="28"
                Padding="12,0,14,0"
                Command="{x:Bind ViewModel.ConvertCommand}"
                AutomationProperties.Name="{x:Bind ViewModel.ConvertButtonText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.ConvertButtonText, Mode=OneWay}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
