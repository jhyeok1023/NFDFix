<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="NFDFix.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{StaticResource DefaultContentDialogStyle}"
    x:Uid="AboutDialog"
    CloseButtonStyle="{StaticResource AccentButtonStyle}"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">24,24,24,20</Thickness>

        <Style x:Key="AboutLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0,12,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="AboutLinkTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="AboutLinkDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AboutDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Width="390" Spacing="16">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="48" Height="48"
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png"
                AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="NFDFix" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="VersionText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Uid="AboutDescription"
            FontSize="13" LineHeight="20"
            TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <StackPanel>
                <Button
                    Style="{StaticResource AboutLinkButtonStyle}"
                    Tag="https://github.com/jhyeok1023/NFDFix"
                    x:Uid="AboutSourceButton"
                    Click="OnLinkClick"
                    ToolTipService.ToolTip="https://github.com/jhyeok1023/NFDFix">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" FontSize="16" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AboutSourceTitle" Style="{StaticResource AboutLinkTitleStyle}" />
                            <TextBlock Text="github.com/jhyeok1023/NFDFix" Style="{StaticResource AboutLinkDescriptionStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <Rectangle Style="{StaticResource AboutDividerStyle}" />

                <Button
                    Style="{StaticResource AboutLinkButtonStyle}"
                    Tag="https://github.com/jhyeok1023/NFDFix/blob/main/LICENSE"
                    x:Uid="AboutLicenseButton"
                    Click="OnLinkClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AboutLicenseTitle" Style="{StaticResource AboutLinkTitleStyle}" />
                            <TextBlock Text="BSD 3-Clause License" Style="{StaticResource AboutLinkDescriptionStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <Rectangle Style="{StaticResource AboutDividerStyle}" />

                <Button
                    Style="{StaticResource AboutLinkButtonStyle}"
                    Tag="https://github.com/jhyeok1023/NFDFix/blob/main/THIRD-PARTY-NOTICES.md"
                    x:Uid="AboutNoticesButton"
                    Click="OnLinkClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AboutNoticesTitle" Style="{StaticResource AboutLinkTitleStyle}" />
                            <TextBlock x:Uid="AboutNoticesDescription" Style="{StaticResource AboutLinkDescriptionStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock
            Text="Copyright © 2026 Junhyeok Soung"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</ContentDialog>
